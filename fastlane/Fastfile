require "tmpdir"
require_relative "qa_version"

default_platform(:ios)

platform :ios do
  desc "Archive와 번들 검사까지만 수행한다. 애플 서버에 아무것도 보내지 않아 빌드 번호를 소모하지 않는다"
  lane :verify do
    build_and_check
    UI.success("검증 완료. 업로드는 수행하지 않았다.")
  end

  desc "/qa가 올릴 앱 버전을 정한다. 애플에서 읽기만 하고 아무것도 바꾸지 않는다"
  lane :qa_version do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY")
    )

    # fastlane은 레인을 fastlane/ 폴더에서 실행하므로 저장소 루트는 한 단계 위다.
    develop_version = File.read("../QueenCam/QueenCam.xcodeproj/project.pbxproj")[/MARKETING_VERSION = ([^;]+);/, 1]
    UI.user_error!("project.pbxproj에서 MARKETING_VERSION을 읽지 못했습니다.") if develop_version.nil?

    app = Spaceship::ConnectAPI::App.find("com.queendom.QueenCam")
    UI.user_error!("App Store Connect에서 앱을 찾지 못했습니다.") if app.nil?

    versions = app.get_app_store_versions(filter: { platform: "IOS" })

    # 어느 필드에 상태가 채워지는지 실행으로 확인하려고 둘 다 남긴다.
    UI.message("── App Store Connect 버전 목록 ──")
    versions.each do |v|
      UI.message("  #{v.version_string}: app_version_state=#{v.app_version_state.inspect} app_store_state=#{v.app_store_state.inspect}")
    end

    store_versions = versions.map { |v| [v.version_string, v.app_version_state || v.app_store_state] }
    result = QaVersion.decide(develop_version, store_versions)

    highest_state = store_versions.find { |version, _| version == result[:highest_submitted] }&.last
    summary = "develop=#{develop_version}, 제출된 최고 버전=#{result[:highest_submitted] || '없음'}(#{highest_state}) → " \
              "#{result[:bumped] ? '앱 버전을 올림' : '앱 버전 유지'}: #{result[:version]}"
    UI.success(summary)

    # fastlane 출력을 해석하지 않고 워크플로 환경 변수로 직접 넘긴다.
    if ENV["GITHUB_ENV"]
      File.open(ENV["GITHUB_ENV"], "a") do |f|
        f.puts("QA_APP_VERSION=#{result[:version]}")
        f.puts("QA_VERSION_BUMPED=#{result[:bumped]}")
        f.puts("QA_HIGHEST_SUBMITTED=#{result[:highest_submitted]}(#{highest_state})")
        f.puts("QA_PREVIOUS_VERSION=#{develop_version}")
      end
    end
  end

  desc "verify가 만든 IPA를 TestFlight에 올린다. Archive는 하지 않는다"
  lane :upload_build do
    # 레인은 fastlane/ 폴더에서 실행되지만 gym은 저장소 루트의 build/에 IPA를 만든다.
    # upload_to_testflight는 상대 경로를 저장소 루트 기준으로 풀어 한 단계 위 폴더를 찾으므로 절대 경로로 넘긴다.
    ipa = File.expand_path("../build/QueenCam.ipa")
    UI.user_error!("#{ipa}가 없습니다. Archive 단계가 먼저 성공해야 합니다.") unless File.exist?(ipa)
    UI.message("업로드할 IPA: #{ipa}")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY")
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Archive QueenCam and upload the resulting IPA to TestFlight"
  lane :testflight do
    build_and_check

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY")
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  # 설정 파일이 빠져도 Archive는 성공하고 앱만 실행 즉시 죽는다. 업로드한 빌드 번호는
  # 다시 쓸 수 없으므로 업로드 전에 확인한다.
  private_lane :build_and_check do
    build_app(
      project: "QueenCam/QueenCam.xcodeproj",
      scheme: "QueenCam",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.queendom.QueenCam" => "QueenCamAppStore"
        }
      },
      output_directory: "build",
      output_name: "QueenCam.ipa",
      clean: true
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    bundled = sh("unzip -Z1 '#{ipa_path}'", log: false).split("\n")

    unless bundled.any? { |entry| entry.end_with?("/GoogleService-Info.plist") }
      UI.user_error!("IPA에 GoogleService-Info.plist가 없습니다. 업로드를 중단합니다.")
    end

    UI.success("GoogleService-Info.plist가 번들에 포함되었습니다.")

    check_entitlements(ipa_path: ipa_path)
  end

  # Archive와 export를 거치며 권한 주입이 조용히 누락될 수 있다. 빠져도 빌드와 업로드는
  # 성공하고 해당 기능만 동작하지 않아, 실기기에서 써보기 전에는 드러나지 않는다.
  private_lane :check_entitlements do |options|
    ipa_path = options[:ipa_path]
    required = ["com.apple.developer.wifi-aware"]

    Dir.mktmpdir do |dir|
      sh("unzip -q -o '#{ipa_path}' -d '#{dir}'", log: false)
      app = Dir.glob("#{dir}/Payload/*.app").first
      UI.user_error!("IPA에서 .app을 찾지 못했습니다.") if app.nil?

      entitlements = sh("codesign -d --entitlements :- '#{app}' 2>/dev/null || true", log: false)

      missing = required.reject { |key| entitlements.include?(key) }
      unless missing.empty?
        UI.error("앱에 들어간 권한:\n#{entitlements}")
        UI.user_error!("다음 권한이 앱에 없습니다: #{missing.join(', ')}. 업로드를 중단합니다.")
      end

      UI.success("필요한 권한이 모두 포함되었습니다: #{required.join(', ')}")

      # 로컬 빌드와 달라질 수 있는 값을 한눈에 볼 수 있게 남긴다.
      UI.message("── 빌드 산출물 점검 ──")
      UI.message("권한 전체:\n#{entitlements}")
      info = "#{app}/Info.plist"
      %w[
        CFBundleShortVersionString CFBundleVersion CFBundleIdentifier
        MinimumOSVersion QueenCamCompatibleMinimumVersion VOCPageURL
      ].each do |key|
        value = sh("plutil -extract #{key} raw '#{info}' 2>/dev/null || echo '(없음)'", log: false).strip
        UI.message("  #{key} = #{value}")
      end
      has_wa = sh("plutil -extract WiFiAwareServices xml1 -o - '#{info}' >/dev/null 2>&1 && echo yes || echo no", log: false).strip
      UI.message("  WiFiAwareServices = #{has_wa}")
      fonts = sh("ls '#{app}' | grep -c '\\.ttf$' || true", log: false).strip
      UI.message("  번들 폰트 = #{fonts}개")
      profile = sh("test -f '#{app}/embedded.mobileprovision' && security cms -D -i '#{app}/embedded.mobileprovision' 2>/dev/null | plutil -extract Name raw - 2>/dev/null || echo '(없음)'", log: false).strip
      UI.message("  embedded 프로파일 = #{profile}")
    end
  end
end
